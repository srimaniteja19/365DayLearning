{
  "manifest_version": 3,
  "name": "Refrainly — Save to Bookmarks & Learned",
  "version": "1.0.0",
  "description": "Quickly save pages to your Refrainly Bookmarks board or Learned journal.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Refrainly"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.refrainly.app/*",
    "https://refrainly.app/*",
    "https://*.refrainly.dev/*",
    "https://refrainly.dev/*"
  ]
}
