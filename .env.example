ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Accounts + cloud sync (optional). Without these the app runs fully
# local (IndexedDB/localStorage) with no login. See README for setup.
# Vercel → Storage → Create Database → Neon → copy the pooled connection string.
DATABASE_URL=
# Generate with: npx auth secret
AUTH_SECRET=
