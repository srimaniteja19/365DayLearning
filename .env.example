# Server OpenRouter key for Operator/Architect managed AI (https://openrouter.ai/keys).
# Recruit users bring their own key in Settings instead.
OPENROUTER_API_KEY=
# Optional override (default: deepseek/deepseek-v4-flash)
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional: Jina Reader key for richer article extraction when summarizing
# linked pages (https://jina.ai/reader). Without it, HTML text extraction is used.
# JINA_API_KEY=

# Accounts + cloud sync (required for campaigns / Field Kit). Without these,
# sign-in fails and the app stays on the landing page. See README for setup.
# Vercel → Storage → Create Database → Neon → copy the pooled connection string.
DATABASE_URL=
# Generate with: npx auth secret
AUTH_SECRET=
# Public site URL (production callbacks). Local: http://localhost:3000
# AUTH_URL=https://refrainly.dev
# Google OAuth (Auth.js). Create a Web client in Google Cloud Console.
# Redirect URIs: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe (Billing + Checkout). Use test keys locally; never commit real secrets.
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# One Price ID per paid tier (monthly recurring). Create in Dashboard or via API.
STRIPE_PRICE_OPERATOR=
STRIPE_PRICE_ARCHITECT=

# Optional: Upstash Redis for durable, cross-instance rate limiting.
# Vercel → Storage → Create Database → Upstash (via Marketplace), or create
# a free database directly at https://upstash.com and copy the REST credentials.
# Without these, rate limiting falls back to an in-memory, per-instance limiter.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
